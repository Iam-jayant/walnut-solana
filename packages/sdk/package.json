{
  "name": "@walnut/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Typed client SDK for the Walnut-Solana program",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.tx-size.json && tsc -p tsconfig.bench.json",
    "test": "node --test \"test/*.test.ts\"",
    "test:tx-size": "node tx-size/measure.ts",
    "bench": "node bench/run.ts",
    "bench:latency": "node bench/run.ts latency",
    "bench:contention": "node bench/run.ts contention",
    "bench:init-devnet": "node bench/init.ts",
    "demo:balance": "node demo/balance-demo.ts",
    "demo:loan": "node demo/loan-demo.ts",
    "demo:lend": "node demo/lend-e2e.ts",
    "demo:private": "node demo/private-e2e.ts",
    "demo:supply": "node demo/supply-demo.ts",
    "demo:oracle": "node demo/oracle-devnet.ts",
    "bench:selftest": "node --test bench/stats.test.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  }
}
