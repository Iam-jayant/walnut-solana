# Solana RPC endpoint used by the browser. Optional: when unset, the Web App
# uses the public devnet RPC (https://api.devnet.solana.com), which is
# rate-limited. NEXT_PUBLIC_* values are embedded in the browser bundle, so only
# use a devnet key that is restricted to your domain. Never commit real keys.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com