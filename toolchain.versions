# Walnut-Solana coordinated toolchain: single source of truth.
#
# Every other pin in the repository must match these values:
#   rust-toolchain.toml        channel
#   Anchor.toml [toolchain]    anchor_version, solana_version
#   Cargo manifests            anchor-lang, arcium-*, arcis (exact "=" pins)
#   package.json               packageManager, engines.node, @arcium-hq/client,
#                              @anchor-lang/core, pnpm.overrides
#   .nvmrc / .node-version     Node version
#
# scripts/check-toolchain.sh reads this file and reports every mismatch.
# Format: plain KEY=VALUE lines (sourced by bash). No spaces around "=".
#
# Verified 2026-11 against the Arcium docs (installation, continuous-integration,
# versioning, release-notes) and the crates.io / npm registries. See
# docs/WSL2_SETUP.md#compatibility-matrix for sources.

# Coordinated Arcium release: CLI (arcup), Rust crates, TypeScript client, Arx node image.
ARCIUM_VERSION=0.16.0

# Anchor CLI, anchor-lang crate, and @anchor-lang/core. arcium-anchor 0.16.0
# depends on anchor-lang =1.0.2, so this cannot move independently of Arcium.
ANCHOR_VERSION=1.0.2

# Agave (Solana) CLI, as listed in the Arcium installation prerequisites.
SOLANA_CLI_VERSION=3.1.10

# Host Rust toolchain (anchor-cli, IDL build, Arcis circuits, clippy, rustfmt).
# Arcium does not publish a Rust pin; this is the latest stable patch release
# at the Arcium 0.16.0 release date. On-chain SBF builds use the platform-tools
# bundled with the Solana CLI above.
RUST_VERSION=1.99.1

# Node.js: the version installed on the reference WSL2 machine. Arcium's CI guide
# defaults setup-arcium to 24.10.0 and only asks projects to match their own pin;
# Arcium publishes no Node upper bound.
NODE_VERSION=26.13.1

# pnpm: workspace package manager.
PNPM_VERSION=9.15.9
